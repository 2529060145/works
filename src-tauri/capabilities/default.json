{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**/*" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" }
      ],
      "deny": [
        { "path": "$APPLOCALDATA/EBWebView" },
        { "path": "$APPLOCALDATA/EBWebView/**/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**/*" },
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
